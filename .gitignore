# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This repo is split by tier: `frontend/` today, `backend/` later. Patterns below are
# deliberately NOT anchored to the repo root, so they apply inside every tier.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# E2E screenshots
# A pattern containing a slash is anchored to this file's directory, so it needs the
# `**/` prefix to reach inside frontend/ (and, later, backend/).
**/tests/e2e/screenshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

e2e-screenshots

# AI workspace
.agents
.claude
CLAUDE.md
frontend/CLAUDE.md
frontend/AGENTS.md
backend/CLAUDE.md
backend/AGENTS.md
